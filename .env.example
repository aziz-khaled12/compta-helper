# ============================================================================
# compta-helper environment
#
# Local dev: copy to `.env` at the repo root. It is the ONLY environment source
# — the server and client dev scripts load it with `node --env-file=../../.env`,
# and lib/db/drizzle.config.ts calls loadEnvFile("../../.env") explicitly.
#
# Production: `.env` is gitignored and never deployed. Set these in the Render
# dashboard (or via render.yaml) for the API, and in Vercel for the client.
# ============================================================================

# --- Database ---------------------------------------------------------------
# Required by lib/db — the pool throws at import if this is missing.
# Local: matches docker-compose.yaml (`docker compose up -d db`).
# Render: injected automatically from the blueprint's `fromDatabase` binding.
#   Use the INTERNAL url for the service itself, but the EXTERNAL url when
#   running `pnpm --filter @workspace/db run push` from your machine.
#   Append `?sslmode=require` when connecting from outside Render.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/compta_helper

# --- Server (artifacts/server) ----------------------------------------------
# Required — index.ts throws at boot rather than defaulting.
# Render sets PORT automatically; do not hardcode it there.
PORT=8080

# Required — auth.ts throws at boot rather than falling back to a shared
# literal. Generate one with: openssl rand -hex 32
# Render: `generateValue: true` in render.yaml creates and holds this for you.
JWT_SECRET=

# Required — index.ts calls assertGeminiConfigured() before listening, so the
# server refuses to start without it. Powers the legal-corpus crawl and the
# insights narration (Gemini narrates, it never computes).
GEMINI_API_KEY=

# Comma-separated browser origins allowed to make credentialed CORS requests.
# Optional: when unset, the origin is reflected only outside production.
# Under the Vercel-proxied setup the browser never calls Render cross-origin,
# so this is defence in depth rather than a hard requirement.
CORS_ORIGINS=

# Refresh-cookie attributes. Optional — leave unset to keep the defaults
# (SameSite=Lax, Secure whenever NODE_ENV !== "development").
# Only set these to `none` / `true` if you switch to the browser calling the
# API cross-origin instead of through the Vercel rewrite.
COOKIE_SAMESITE=
COOKIE_SECURE=

# pino level. Optional, defaults to "info".
LOG_LEVEL=

# --- Client (artifacts/client) ----------------------------------------------
# Required only to SERVE the dev server — `vite build` no longer needs them.
# The client's dev server proxies /api to http://localhost:8080, so the server
# must be running for the frontend to do anything.
FRONTEND_PORT=5173

# Vite `base` and the wouter router base. Required only to serve; the
# production build defaults to "/", which is correct for a Vercel root deploy.
BASE_PATH=/

# NODE_ENV=development keeps the pino-pretty transport enabled and marks the
# refresh cookie non-Secure so it survives plain-HTTP localhost.
# Render and Vercel both set `production` themselves — do not override it there.
NODE_ENV=development

# --- Legal-corpus crawl scheduler (artifacts/server/src/lib/scheduler.ts) ----
# The scheduler runs in-process and is ON unless CRAWL_ENABLED is exactly
# "false". Render's free tier sleeps after 15 minutes idle, which stops it;
# set false there and move the crawl to a Render Cron Job if you need it.
CRAWL_ENABLED=false
CRAWL_YEAR=
CRAWL_ISSUES_PER_RUN=
CRAWL_INTERVAL_MINUTES=
CRAWL_INITIAL_DELAY_SECONDS=

# --- Replit-only (ignored everywhere else) ----------------------------------
# REPL_ID enables the cartographer and dev-banner Vite plugins. Both, along
# with the runtime-error overlay, are dev-only and stay off when it is unset.
REPL_ID=
