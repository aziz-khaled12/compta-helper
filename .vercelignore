# ============================================================================
# Vercel upload exclusions.
#
# `vercel deploy` uploads the working tree, and it does not apply .gitignore to
# that upload set — hence this file.
#
# `.local/` is the reason this file exists. It is Replit's local state
# directory and holds 35,615 files, which on its own trips Vercel's
# 15,000-file limit before the build ever starts. node_modules is excluded by
# Vercel already; .local is not.
#
# `.env` is the line that matters for safety. It holds DATABASE_URL and
# GEMINI_API_KEY, and uploading it would hand production secrets to the build
# container. The client build reads none of Vercel's env vars, so nothing here
# is needed to build.
# ============================================================================

# Replit local state — 35,615 files.
.local

.env
.env.*

.git
.vercel

dist
tmp
*.tsbuildinfo

# Scratch harnesses, agent config, and docs. None of it is part of the build.
scripts/_tmp_*.ts
.agents
.claude
.opencode
CLAUDE.md
replit.md
