{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile --no-prod",
  "buildCommand": "pnpm --filter @workspace/client run build",
  "outputDirectory": "artifacts/client/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://compta-api-7xrx.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
